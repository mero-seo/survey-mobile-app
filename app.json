{
  "expo": {
    "name": "सर्वेक्षण फारम",
    "slug": "survey",
    "version": "1.0.1",
    "orientation": "landscape",
    "icon": "./assets/images/Emblem_of_Nepal.png",
    "scheme": "survey",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "buildNumber": "2"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/Emblem_of_Nepal.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.meroseo.survey",
      "versionCode": 2
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/Emblem_of_Nepal.png"
    },
    "plugins": ["expo-router", "expo-font"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6f379fdb-75ad-4dd7-b498-77a7e6a0251f"
      }
    },
    "owner": "vivin61360"
  }
}
