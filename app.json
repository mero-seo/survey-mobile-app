{
  "expo": {
    "name": "सर्वेक्षण फारम",
    "slug": "survey",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/images/Emblem_of_Nepal.png",
    "scheme": "survey",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/Emblem_of_Nepal.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.meroseo.survey"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/Emblem_of_Nepal.png"
    },
    "plugins": ["expo-router", "expo-font"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b652581d-6fd9-4657-bb7f-fd38c7d05516"
      }
    },
    "owner": "aditya3062"
  }
}
